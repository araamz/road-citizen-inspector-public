{
  "name": "@road-citizen-inspector/server-map",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "keywords": [
    "lib"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./map": { 
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js",
      "require": "./dist/map.cjs"      
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/map.ts --dts --format esm,cjs --clean",
    "clean": "rimraf dist && rimraf node_modules",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@road-citizen-inspector/models": "workspace: *",
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.5.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
