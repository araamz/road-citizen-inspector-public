{
  "name": "@road-citizen-inspector/schemas",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "keywords": [
    "lib"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./session": {
      "types": "./dist/session/session.index.d.ts",
      "import": "./dist/session/session.index.js",
      "require": "./dist/session/session.index.cjs"
    },
    "./uplink": {
      "types": "./dist/uplink/uplink.index.d.ts",
      "import": "./dist/uplink/uplink.index.js",
      "require": "./dist/uplink/uplink.index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/session/session.index.ts src/uplink/uplink.index.ts --dts --no-external --external=@road-citizen-inspector/tcd-uplink-protocol --format esm,cjs --clean",
    "clean": "rimraf dist && rimraf node_modules",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@road-citizen-inspector/tcd-uplink-protocol": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.0"
    
  }
}
