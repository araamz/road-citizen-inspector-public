{
  "name": "@road-citizen-inspector/password-strategy",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "keywords": [
    "lib"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./256": {
      "types": "./dist/sha256.password_strategy.d.ts",
      "import": "./dist/sha256.password_strategy.js",
      "require": "./dist/sha256.password_strategy.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sha256.password_strategy.ts --dts --platform=node --format esm,cjs --clean",
    "clean": "rimraf dist && rimraf node_modules",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
